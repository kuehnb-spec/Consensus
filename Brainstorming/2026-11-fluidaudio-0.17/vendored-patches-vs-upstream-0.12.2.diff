-            if pool.count >= count {
-                storage[key] = pool
-                return
-            }
-
-            let additional = count - pool.count
-            pool.reserveCapacity(count)
-            for _ in 0..<additional {
-                let array = try MLMultiArray(shape: shape, dataType: dataType)
-                if zeroFill {
-                    zero(array)
-                }
-                pool.append(array)
