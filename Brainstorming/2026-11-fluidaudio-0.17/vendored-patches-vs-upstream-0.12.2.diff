-
-        if phonemes == nil {
-            phonemes = lexicon[normalized]
-        }
-
-        if phonemes == nil, let ipa = try EspeakG2P.shared.phonemize(word: normalized) {
-            let mapped = PhonemeMapper.mapIPA(ipa, allowed: allowed)
-            if !mapped.isEmpty {
-                phonemes = mapped
